# Docker Compose -> postgres service
POSTGRES_USER=padosi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=padosi

# Used when running the API on the host (optional); Compose overrides DATABASE_URL in the container.
DATABASE_URL=postgresql://padosi:change-me@localhost:5432/padosi

# Required: at least 32 characters each, and they must be different values.
JWT_SECRET=replace-with-at-least-32-characters
OTP_SECRET=replace-with-a-different-32-character-secret

# Mailpit when using docker compose (SMTP on host port 1025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@example.com

PORT=3000
